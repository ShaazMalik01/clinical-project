      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    },
    {
      "name": "Final evaluation (Phase 10)",
      "type": "debugpy", "request": "launch", "program": "${workspaceFolder}/run_phase10.py",
      "cwd": "${workspaceFolder}", "console": "integratedTerminal"
    }
  ]
